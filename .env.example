# Copy to .env and adjust. All values have sane defaults; nothing here is required.

# Trading platform to track: pc | ps4 | xbox | switch | mobile
VOIDBROKER_PLATFORM=pc

# Language for item names / i18n (14 supported, e.g. en, ru, de, fr, es, ja, ko)
VOIDBROKER_LANGUAGE=en

# Include cross-play orders from other platforms (true/false)
VOIDBROKER_CROSSPLAY=false

# Path to the local DuckDB archive (the moat: accumulates forever)
VOIDBROKER_DB_PATH=data/voidbroker.duckdb

# Requests per second against api.warframe.market (their guidance is ~3/s)
VOIDBROKER_RATE_LIMIT=3.0

# Optional: a warframe.market JWT, only needed for authenticated endpoints.
# Public read endpoints (items, statistics, orders) do NOT require this.
# VOIDBROKER_WFM_TOKEN=
